# =============================================================================
# NovaCart AI Operations Copilot – Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# The application loads these via python-dotenv.

# ── LLM Provider ───────────────────────────────────────────────────────────
# Which backend to use for the main language model.
# Accepted values: "openai" | "ollama"
LLM_PROVIDER=openai

# ── OpenAI Settings ────────────────────────────────────────────────────────
# Used when LLM_PROVIDER=openai.
# Get your API key from https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-your-key-here
# Model identifier – "gpt-4o-mini", "gpt-4o", "gpt-4", "gpt-3.5-turbo", etc.
OPENAI_MODEL=gpt-4o-mini

# ── Ollama Settings ────────────────────────────────────────────────────────
# Used when LLM_PROVIDER=ollama.
# Base URL of the local Ollama instance (default: http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Name of the model pulled locally, e.g. "llama3.2:3b", "mistral", "codellama".
OLLAMA_MODEL=llama3.2:3b

# ── Embedding Model ────────────────────────────────────────────────────────
# Uses sentence-transformers/all-MiniLM-L6-v2 by default (offline, free).
# No configuration needed unless you want OpenAI or Ollama embeddings.
# EMBEDDING_PROVIDER=openai

# ── Logging ────────────────────────────────────────────────────────────────
# Python log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Path to the application log file (relative to project root).
LOG_FILE=logs/agent.log
